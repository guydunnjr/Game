{
  "name": "plain-terms-desktop",
  "version": "0.3.0",
  "description": "Desktop MVP for Terms-of-Service simplification and risk analysis.",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build-manifest": "node scripts/build-corpus-manifest.mjs",
    "pack-win": "electron-builder --win portable",
    "pack-all": "electron-builder -mwl",
    "build-lexicon-candidates": "node scripts/build-lexicon-candidates.mjs"
  },
  "devDependencies": {
    "electron": "^31.2.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.plainterms.desktop",
    "productName": "Plain Terms",
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "translator.js",
      "main.js",
      "README.md",
      "package.json",
      "data/**/*"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
